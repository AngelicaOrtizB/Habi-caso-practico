        {
          "name": "Ana cobra $100.000 de la cena a Beto, Caro y Dani",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "cobro-cena-{{anaId}}"
              }
            ],
            "url": "{{base}}/cobros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cobradorId\": \"{{anaId}}\",\n  \"totalCentavos\": 10000000,\n  \"descripcion\": \"La cena de cumpleaños\",\n  \"deudores\": [\n    \"{{betoId}}\",\n    \"{{caroId}}\",\n    \"{{daniId}}\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "const cobro = pm.response.json();",
                  "pm.collectionVariables.set(\"cobroId\", cobro.id);",
                  "pm.collectionVariables.set(\"cuotaBeto\", pm.response.json().cuotas.find(c => c.deudorCuentaId === pm.collectionVariables.get(\"betoId\")).id);",
                  "pm.collectionVariables.set(\"cuotaCaro\", pm.response.json().cuotas.find(c => c.deudorCuentaId === pm.collectionVariables.get(\"caroId\")).id);",
                  "pm.collectionVariables.set(\"cuotaDani\", pm.response.json().cuotas.find(c => c.deudorCuentaId === pm.collectionVariables.get(\"daniId\")).id);",
                  "pm.test(\"Reparto: $33.333,34 + $33.333,33 + $33.333,33\", () => pm.expect(cobro.cuotas.map(c => c.montoCentavos)).to.eql([3333334, 3333333, 3333333]));",
                  "pm.test(\"Las cuotas suman exactamente el total\", () => pm.expect(cobro.cuotas.reduce((s, c) => s + c.montoCentavos, 0)).to.eql(10000000));"
                ]
              }
            }
          ]
        },
